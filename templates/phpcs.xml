<?xml version="1.0"?>
<ruleset name="WordPress-Plugin-Standards">
    <description>Standard configuration for WordPress Plugins.</description>

    <!-- Scan PHP files -->
    <arg name="extensions" value="php"/>

    <!-- Show progress, colors, and sniff codes -->
    <arg value="ps"/>
    <arg name="colors"/>

    <!-- Use the WordPress standard -->
    <rule ref="WordPress"/>
    
    <!-- Minimum WP Version -->
    <config name="minimum_wp_version" value="6.5"/>

    <!-- Text Domain Checklist -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="your-plugin-slug"/>
            </property>
        </properties>
    </rule>

    <!-- Global Prefixing -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="yourprefix"/>
            </property>
        </properties>
    </rule>

    <!-- Exclude 3rd party folders -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
</ruleset>
